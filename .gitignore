# --- Belkins BirdNET: local-only material, deliberately not shipped ---
# Claude Code session data
.claude/
# Large source / reference imagery kept on disk for working
avian/assets/references/
# Superseded assets retained locally
avian/assets/_legacy/

# Belkins BirdNET private planning docs (local only — do NOT publish to the public repo)
/_plan/
/_design-plan/

# Pi-local runtime state. These are UNTRACKED by design (station-specific, not
# source) — but they were also UNIGNORED, which meant `git clean -fd` on the Pi
# would delete them outright. Ignoring them makes clean skip them.
#
# TWO of these are IRREPLACEABLE — they cannot be recomputed from birds.db:
#
#   * scripts/accessions.json — the append-only accession ledger ("first writer
#     wins, a pin is NEVER overwritten") that assigns each bird its permanent
#     plate number. Lose it and the entire collection renumbers; for a museum
#     whose whole conceit is permanent accession, that is unrecoverable.
#   * scripts/phenology.json — the per-year seasonal ledger. It FREEZES each
#     closed year's first/last/days-heard/peak-week BEFORE disk_check.sh purges
#     the rows behind them, so once those rows are gone it is the only record
#     that year ever existed.
#
# Everything else regenerates: species.json + christina.db nightly, derived.json
# from birds.db.
#
# NOTE: `git clean -fdx` still removes ignored files. Keep the systemd-timer
# backup (avian/catalog/accessions-backup.*) as the real safety net.
scripts/accessions.json
scripts/accessions-backups/
scripts/derived.json
scripts/phenology.json
scripts/species.json
scripts/christina.db

# secrets — NEVER commit (this is a PUBLIC repo)
.env
.env.local
.env.*.local
secrets/

# Raw plate originals from c82.net — 25MB of source JPEGs the fetcher caches so a
# re-run costs no requests. Regenerable by tools/jardine/fetch_plates.py; only the
# resized plates under web/public/jardine/ ship.
tools/jardine/cache/

# Generated WebP variants of the plates (avian/catalog/webp_variants.py). These are
# derived from the committed PNGs and rebuilt by nightly.sh, so they must never be
# committed: a plain `git add -A` would otherwise drag ~500 files / ~18 MB of
# regenerable output into the repo. The .png plates themselves stay tracked.
avian/assets/illustrations/*.webp
avian/assets/cutouts/*.webp

# workflow-kit: track ONLY the kit configuration under .claude/
!.claude/
.claude/*
!.claude/workflow-kit.json
