[flake8]
max-line-length = 160
max-complexity = 15

# services/birdgen/ is canonical; avian/scripts/ holds SYMLINKS to it (see
# services/birdgen/README.md). flake8 follows symlinks, so without this it lints
# the same bytes twice and every finding in the shared pipeline is reported
# double — 164 of 354 findings were one file counted twice, which both inflated
# the debt and made a real fix look like it had changed nothing.
# Lint the canonical copy only.
# .claude holds git worktrees (`git worktree add .claude/worktrees/<name>`),
# i.e. a FULL SECOND CHECKOUT of this repo inside the repo. Without this,
# flake8 lints every file twice and reports 21 findings that are the other
# checkout's copy of the same lines — the identical double-count the symlink
# note below records, arriving by a different route. It also loses the
# per-file-ignores below, because those are relative paths that do not match
# `.claude/worktrees/*/services/birdgen/verify.py`, so the worktree's copy of
# a deliberately-exempt file reports as a fault.
#
# Same scope gap as scripts/repo-guards.sh guard 3, which discovered the
# worktree's five test suites and failed the whole guard suite on a clean tree.
# Fixed there 2026-08-01; this is the second instance of the same class.
exclude =
    .git,
    .claude,
    __pycache__,
    node_modules,
    web/dist,
    venv,
    .venv,
    avian/scripts/pregen.py,
    avian/scripts/verify.py,
    avian/scripts/creamkey.py

# verify.py's long lines are all inside VERIFY_PROMPT — the text SENT TO THE
# MODEL. Re-wrapping a prompt is not a formatting change, it is a behavioural
# one: this is the adversarial species-ID/anatomy gate, and it fails OPEN, so a
# subtly reworded prompt degrades quality with no error anywhere. Left long on
# purpose. Scoped to E501 in this one file so every other rule still applies.
per-file-ignores =
    services/birdgen/verify.py:E501
