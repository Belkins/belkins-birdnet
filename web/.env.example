# Belkins BirdNET — collage shell (Phase 0) configuration.
# Copy to `.env.local` to point at a real backend, or leave defaults for mock.

# '1' = fully self-contained demo (bundled snapshot + internal event
# generator, no backend). Anything else = talk to a real birdcast.
VITE_MOCK=1

# Legacy PHP API base (snapshot via birdnet-api.php, images via cutout.php).
# Default: /avian/api
VITE_API_BASE=/avian/api

# SSE stream emitting hello + bird.detected frames.
# Default: /events
VITE_EVENTS_URL=/events
