[Unit]
Description=Belkins BirdNET birdcast realtime SSE service
After=network-online.target

[Service]
Type=simple
# Edit User= if BirdNET-Pi was installed under a different account.
# The ExecStart path uses a relative path because WorkingDirectory=~ respects
# User= (unlike systemd's %h specifier, which expands to /root for system-mode
# units). Copy birdcast.py into the user's home as ~/birdcast.py (see README).
User=birdnet
WorkingDirectory=~
ExecStart=/usr/bin/python3 birdcast.py
# Optional: point at a non-default birds.db.
# Environment=AV_BIRDS_DB=/home/birdnet/BirdNET-Pi/scripts/birds.db
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
