[Unit]
Description=Christina auto-gen watcher forwarder (birdcast -> Railway detections bridge)
# Start after the network is up and birdcast (the SSE source) is available.
After=network-online.target birdcast.service
Wants=network-online.target

[Service]
Type=simple
# deploy-christina.sh / deploy-realtime.sh rewrite User= and every
# /home/belkins path below to the installing user at install time.
# Manual install: sed the same way (see avian/realtime/README.md).
User=belkins
# Forwarder-only secrets/config (NEVER the Gemini key). Holds at minimum:
#   AV_RAILWAY_BASE, WATCHER_WEBHOOK_SECRET
# Optional overrides: BIRDCAST_EVENTS, AV_ILLUSTRATIONS, AV_CONF.
EnvironmentFile=/home/belkins/.christina/forwarder.env
WorkingDirectory=/home/belkins/BirdNET-Pi/avian/realtime
ExecStart=/usr/bin/python3 /home/belkins/BirdNET-Pi/avian/realtime/forwarder.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
