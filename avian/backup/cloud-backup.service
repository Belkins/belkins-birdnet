[Unit]
Description=Christina — encrypted off-site backup to object storage (birds.db + ledgers + every recording and spectrogram)
After=network-online.target
Wants=network-online.target
# The script pushes its own refusals (exit 2/3) and faults (exit 4/5), but only
# once it runs far enough to push. This catches everything outside that: a bash
# that will not start, an EnvironmentFile systemd cannot read, a SIGKILL from
# TimeoutStartSec on a stalled upload. Same handler every other unit here uses;
# it refuses to alert about itself, so there is no loop.
OnFailure=christina-alert@%n.service

[Service]
Type=oneshot
# install-cloud-backup.sh rewrites User= and the /home/belkins paths at install
# time, matching deploy-realtime.sh's render_unit().
User=belkins
# The detector and the museum always win. Encryption plus upload is CPU and
# network work on a 1 GB board that is also running BirdNET inference; at idle
# priority it fills the gaps instead of competing for them.
Nice=19
IOSchedulingClass=idle

