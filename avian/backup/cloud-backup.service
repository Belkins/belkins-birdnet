[Unit]
Description=Christina — encrypted off-site backup to object storage (birds.db + ledgers + every recording and spectrogram)
After=network-online.target
Wants=network-online.target
# The script pushes its own refusals (exit 2/3) and faults (exit 4/5), but only
# once it runs far enough to push. This catches everything outside that: a bash
# that will not start, an EnvironmentFile systemd cannot read, a SIGKILL from
# TimeoutStartSec on a stalled upload. Same handler every other unit here uses;
# it refuses to alert about itself, so there is no loop.
OnFailure=christina-alert@%n.service

[Service]
Type=oneshot
# install-cloud-backup.sh rewrites User= and the /home/belkins paths at install
# time, matching deploy-realtime.sh's render_unit().
User=belkins
# The detector and the museum always win. Encryption plus upload is CPU and
# network work on a 1 GB board that is also running BirdNET inference; at idle
# priority it fills the gaps instead of competing for them.
Nice=19
IOSchedulingClass=idle

# NOTIFY_URL (the shared ntfy topic mic-watch and railway-liveness already push
# to) lives here. Leading '-' so a box without it still runs -- christina-alert
# goes RED and says so rather than failing silently.
EnvironmentFile=-/home/belkins/.christina/forwarder.env
# R2 credentials and the crypt remote name. UNSET IS A HARD REFUSAL (exit 2): a
# backup unit that reports green while writing nowhere is worse than no unit.
EnvironmentFile=-/home/belkins/.christina/cloud-backup.env
Environment=CLOUD_BACKUP_STATE=/home/belkins/.christina/cloud-backup.state

# A oneshot with an unbounded start timeout can hang in `activating` forever and
# NEVER be reported failed -- the same trap documented in catalog.service and
# offbox-backup.service. A dead TCP connection to R2 is exactly that case.
# 2h is generous: the nightly delta is ~52 MB (about 2 minutes at this link's
# measured throughput). The one big run is the initial ~1.6 GB seed, which
# install-cloud-backup.sh has you do by hand so the timer never carries it.
TimeoutStartSec=7200

ExecStart=/bin/bash /home/belkins/BirdNET-Pi/avian/backup/cloud-backup.sh

# No [Install] section on purpose: offbox-backup.service, railway-liveness.service
# and mic-watch.service (all timer-driven oneshots) carry none either, so the only
# enableable unit is the .timer.
