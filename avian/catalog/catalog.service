[Unit]
Description=Christina species catalog rebuild (christina.db from birds.db, read-only)
# Build after birds.db has had time to exist on boot; ordering only, not a hard dep.
After=network-online.target
# nightly.sh aggregates the exit codes so this unit goes red on a real fault --
# but until now "red" meant "visible to whoever types `systemctl --failed`", i.e.
# nobody, at 03:30. See avian/realtime/christina-alert@.service.
OnFailure=christina-alert@%n.service

[Service]
Type=oneshot
# THE canonical catalog unit. deploy-christina.sh installs THIS file through
# render_unit(), which rewrites User= and /home/belkins/BirdNET-Pi for the real
# account and checkout. Do not hand-roll a second copy in a deploy heredoc --
# that is exactly what caused the 2026-07-02..26 incident: the heredoc version
# had only ONE ExecStart, so derive.py was never installed, and derived.json
# froze for 24 days behind a green unit.
User=belkins
Nice=10
IOSchedulingClass=idle

# Manifest URL comes from the environment at RUN time, not from a flag baked
# into this file at deploy time. `-` => a missing env file is not fatal, but
# rebuild_catalog.py then exits 3 (loudly) rather than mislabelling art.
EnvironmentFile=-/home/belkins/.christina/catalog.env

# 0. Snapshot the accession ledger BEFORE the only job that ever writes it.
#    accessions.json is the one irreplaceable file here (permanent plate
#    numbers); everything else regenerates from birds.db. Never fails the unit.
ExecStartPre=/bin/bash /home/belkins/BirdNET-Pi/avian/catalog/backup-accessions.sh

# A oneshot with an infinite start timeout can NEVER be reported failed: a slow
# (not dead) manifest fetch would leave the unit in 'activating' forever, every
# later trigger a no-op, and the catalog frozen -- silently, which is the whole
# failure class this unit is meant to make loud. Bound it.
TimeoutStartSec=600

# ONE ExecStart, deliberately. systemd.service(5): a non-zero, un-prefixed
# ExecStart means "the rest are not executed" -- verified empirically on this Pi.
# Two chained steps therefore meant rebuild_catalog.py's exit-3 DEGRADED signal
# silently SKIPPED derive.py and re-froze derived.json: the loud signal disabling
# the thing it protected. nightly.sh runs both unconditionally and aggregates the
# exit code, so the unit still goes red without either step being skippable.
ExecStart=/bin/bash /home/belkins/BirdNET-Pi/avian/catalog/nightly.sh

[Install]
WantedBy=multi-user.target
