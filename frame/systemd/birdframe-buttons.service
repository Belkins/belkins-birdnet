[Unit]
Description=Belkins BirdNET frame buttons (A Real time, B Today, C Week, D All Time)
Documentation=https://github.com/Belkins/belkins-birdnet
# No network needed: the daemon only watches GPIO edges and writes one small
# file; the paint it triggers does its own waiting.
OnFailure=christina-alert@%n.service

[Service]
# install.sh rewrites User= and the paths to match your install.
Type=simple
User=monalisa
WorkingDirectory=/home/monalisa/belkins-birdnet/frame
ExecStart=/home/monalisa/belkins-birdnet/frame/.venv/bin/python /home/monalisa/belkins-birdnet/frame/buttons.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10
Nice=10
# A button listener that leaks must still never squeeze the detector. Far
# under birdframe.service's 512M: this process holds no Chromium, ever — the
# paint it triggers runs in birdframe.service's own cgroup with its own cap.
MemoryMax=64M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
