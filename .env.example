# Belkins BirdNET — environment template (SAFE TO COMMIT — placeholders only).
# Copy to `.env` (git-ignored) and fill in real values. NEVER put real secrets here.
#
# Server-side ONLY. The Gemini key must never appear in any VITE_* var (Vite inlines
# those into the public client bundle). Used by avian/scripts/pregen.py + on-demand gen.
# Load:  set -a; source .env; set +a

GEMINI_API_KEY=          # from https://aistudio.google.com/apikey  (server-side only)
GEMINI_PROJECT=          # Google Cloud project number

# Optional:
# EBIRD_API_KEY=         # region species filtering (https://ebird.org/api/keygen)
# AV_BIRDS_DB=           # override path to BirdNET-Pi birds.db (default ~/BirdNET-Pi/scripts/birds.db)
